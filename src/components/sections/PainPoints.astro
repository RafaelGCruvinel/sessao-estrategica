---
import Container from '~/components/layout/Container.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';

const pains = [
  {
    title: 'Margem comprimida',
    body:
      'IBS/CBS muda formação de preço. ICMS migra para destino. Créditos de ST evaporam. O preço que você pratica hoje pode ser inviável em 2027.',
    icon: 'compress',
  },
  {
    title: 'Dinheiro escapando hoje',
    body:
      'Créditos de PIS/COFINS subutilizados, NCM aplicada errado, benefícios estaduais ignorados, regime fiscal mal escolhido. A Reforma ainda nem chegou — e você já paga a mais.',
    icon: 'leak',
  },
  {
    title: 'Insegurança jurídica',
    body:
      'Tese agressiva de hoje vira autuação cinco anos depois. O CFO assina, fica com o risco. O que você quer é dormir tranquilo, não economizar para depois pagar dobrado.',
    icon: 'shield',
  },
];
---

<section class="bg-gray-100 py-20 md:py-28">
  <Container>
    <SectionHeading
      eyebrow="O que está em jogo"
      title="Três pressões que convergem ao mesmo tempo na sua empresa"
      subtitle="A Reforma Tributária não é um evento isolado — é uma reorganização estrutural que se soma às distorções que já existem hoje. Quem espera 2027 para reagir, paga."
    />

    <ul class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-7">
      {pains.map((pain, i) => (
        <li
          class="reveal group bg-gray-50 border border-gray-200 rounded-xl p-7 lg:p-8 transition-all duration-300 hover:border-copper-500/40 hover:-translate-y-0.5 hover:shadow-[var(--shadow-card-hover)]"
          style={`transition-delay: ${i * 80}ms`}
        >
          <div class="flex items-center justify-between">
            <span
              class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-navy-700/8 text-navy-700 group-hover:bg-copper-500/10 group-hover:text-copper-600 transition-colors"
              aria-hidden="true"
            >
              {pain.icon === 'compress' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M3 9V5C3 3.89543 3.89543 3 5 3H9M21 9V5C21 3.89543 20.1046 3 19 3H15M3 15V19C3 20.1046 3.89543 21 5 21H9M21 15V19C21 20.1046 20.1046 21 19 21H15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                  <path d="M9 9H15M9 15H15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                </svg>
              )}
              {pain.icon === 'leak' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M7 2V6M12 2V8M17 2V6M5 10H19L17 22H7L5 10Z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M10 14L12 16M14 14L12 16M12 16V19" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                </svg>
              )}
              {pain.icon === 'shield' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M12 2L3 6V12C3 16.5 6.5 20.5 12 22C17.5 20.5 21 16.5 21 12V6L12 2Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                  <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </span>
            <span class="text-3xl font-display font-light text-gray-300 group-hover:text-copper-300 transition-colors">
              0{i + 1}
            </span>
          </div>

          <h3 class="mt-6 text-xl font-display font-medium text-navy-900 leading-snug">
            {pain.title}
          </h3>
          <p class="mt-3 text-base text-gray-700 leading-relaxed text-pretty">
            {pain.body}
          </p>
        </li>
      ))}
    </ul>
  </Container>
</section>
