---
import Container from '~/components/layout/Container.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';

const rows = [
  {
    label: 'Modelo de honorário',
    consultoria: 'Hora ou projeto fixo',
    big4: 'Hora cheia, projeto alto',
    nos: 'Êxito sobre economia comprovada',
  },
  {
    label: 'Quem assume o risco financeiro',
    consultoria: 'Cliente',
    big4: 'Cliente',
    nos: 'Escritório',
  },
  {
    label: 'Profundidade técnica',
    consultoria: 'Variável — depende do consultor',
    big4: 'Alta, foco jurídico',
    nos: 'Jurídico + Contábil + Tecnologia',
  },
  {
    label: 'Implementação no ERP',
    consultoria: 'Raramente incluída',
    big4: 'Sim, escopo extra caro',
    nos: 'Inclusa no protocolo',
  },
  {
    label: 'Parecer assinado por OAB',
    consultoria: 'Ocasional',
    big4: 'Sim',
    nos: 'Sim — em toda tese',
  },
];
---

<section id="diferencial" class="bg-gray-100 py-20 md:py-28">
  <Container>
    <SectionHeading
      eyebrow="Diferencial"
      title="Por que não é igual a outras consultorias"
      subtitle="Você provavelmente já conversou com Big4 ou consultorias tributárias. Veja onde a Sessão Estratégica é estruturalmente diferente."
    />

    <!-- Tabela desktop -->
    <div class="reveal mt-14 hidden md:block">
      <div class="bg-gray-50 border border-gray-200 rounded-xl overflow-hidden shadow-[var(--shadow-card)]">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-gray-200">
              <th scope="col" class="p-5 text-xs uppercase tracking-wider text-gray-600 font-semibold w-[26%]"></th>
              <th scope="col" class="p-5 text-xs uppercase tracking-wider text-gray-600 font-semibold w-[24%]">
                Consultoria tradicional
              </th>
              <th scope="col" class="p-5 text-xs uppercase tracking-wider text-gray-600 font-semibold w-[24%]">
                Big4
              </th>
              <th
                scope="col"
                class="p-5 text-xs uppercase tracking-wider font-semibold w-[26%] bg-navy-700 text-copper-400 border-l border-r border-copper-500/30"
              >
                Sessão Estratégica
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr class={i < rows.length - 1 ? 'border-b border-gray-200' : ''}>
                <th scope="row" class="p-5 font-display text-base text-navy-900 font-medium align-top">
                  {row.label}
                </th>
                <td class="p-5 text-sm text-gray-700 align-top">
                  {row.consultoria}
                </td>
                <td class="p-5 text-sm text-gray-700 align-top">
                  {row.big4}
                </td>
                <td class="p-5 text-sm text-gray-50 bg-navy-700 align-top font-medium border-l border-r border-copper-500/30">
                  <span class="inline-flex items-center gap-2">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 text-copper-400" aria-hidden="true">
                      <path d="M2 7.5L5 10.5L12 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {row.nos}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Cards empilhados (mobile) -->
    <div class="md:hidden mt-12 space-y-4">
      {rows.map((row) => (
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-5">
          <p class="font-display text-base text-navy-900 font-medium mb-3">{row.label}</p>
          <dl class="text-sm space-y-2">
            <div class="flex justify-between gap-3">
              <dt class="text-gray-500">Consultoria tradicional</dt>
              <dd class="text-gray-700 text-right">{row.consultoria}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-gray-500">Big4</dt>
              <dd class="text-gray-700 text-right">{row.big4}</dd>
            </div>
            <div class="flex justify-between gap-3 pt-2 mt-2 border-t border-gray-200">
              <dt class="text-copper-600 font-semibold">Sessão Estratégica</dt>
              <dd class="text-navy-900 text-right font-medium">{row.nos}</dd>
            </div>
          </dl>
        </div>
      ))}
    </div>
  </Container>
</section>
