---
interface Props {
  question: string;
  open?: boolean;
}

const { question, open = false } = Astro.props;
---

<details
  class="group border-b border-gray-200 py-5 last:border-b-0"
  open={open}
>
  <summary
    class="flex cursor-pointer items-start justify-between gap-6 list-none [&::-webkit-details-marker]:hidden focus-visible:outline-none"
  >
    <span class="font-display text-lg leading-snug text-navy-900 text-balance group-hover:text-navy-700 transition-colors">
      {question}
    </span>
    <span
      aria-hidden="true"
      class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-navy-700/30 text-navy-700 transition-transform duration-300 group-open:rotate-45 group-open:border-copper-500 group-open:text-copper-500"
    >
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
        <path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </span>
  </summary>
  <div class="mt-4 max-w-3xl text-base leading-relaxed text-gray-700 text-pretty">
    <slot />
  </div>
</details>
